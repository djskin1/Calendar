<Window x:Class="CompanyCalendar.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Central calendar"
        Width="600"
        Height="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        Icon="Images/Icon.png">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="125"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#087F8C">

            <Grid Margin="25,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- App logo -->

                <Border Width="90"
                        Height="90"
                        Background="White"
                        CornerRadius="10"
                        Padding="8"
                        VerticalAlignment="Center">

                    <Image Source="/Images/Logo.png"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                </Border>

                <!-- Application name -->

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Central calendar"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Version 2.0"
                               Foreground="#D6F3F5"
                               FontSize="14"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Margin="22"
                Background="White"
                CornerRadius="10"
                Padding="24">

            <StackPanel>

                <TextBlock Text="About Central calendar"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                <TextBlock Text="Employee availability and planning"
                           Margin="0,4,0,15"
                           Foreground="#6B7280"
                           FontSize="13"/>

                <Separator Margin="0,0,0,12"/>

                <!-- Information table -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="31"/>
                        <RowDefinition Height="31"/>
                        <RowDefinition Height="31"/>
                        <RowDefinition Height="31"/>
                        <RowDefinition Height="31"/>
                        <RowDefinition Height="31"/>
                    </Grid.RowDefinitions>

                    <!-- Application -->

                    <TextBlock Grid.Row="0"
                               Text="Application"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="Central calendar"
                               Foreground="#111827"/>

                    <!-- Version -->

                    <TextBlock Grid.Row="1"
                               Text="Version"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="2.0"
                               Foreground="#111827"/>

                    <!-- Platform -->

                    <TextBlock Grid.Row="2"
                               Text="Platform"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="Microsoft Windows"
                               Foreground="#111827"/>

                    <!-- Author -->

                    <TextBlock Grid.Row="3"
                               Text="Author"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="Kevin Verweij"
                               Foreground="#111827"/>

                    <!-- Copyright -->

                    <TextBlock Grid.Row="4"
                               Text="Copyright"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="© 2026 by Djskinproductions"
                               Foreground="#111827"/>

                    <!-- Email -->

                    <TextBlock Grid.Row="5"
                               Text="Email"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>

                    <TextBlock Grid.Row="5"
                               Grid.Column="1">

                        <Hyperlink NavigateUri="mailto:info@djskinproductions.nl?subject=Central%20calendar"
                                   RequestNavigate="EmailLink_RequestNavigate">
                            info@djskinproductions.nl
                        </Hyperlink>

                    </TextBlock>

                </Grid>

                <Separator Margin="0,20,0,18"/>

                <TextBlock TextWrapping="Wrap"
                           Foreground="#6B7280"
                           LineHeight="20"
                           Text="Central calendar provides a modern overview of employee availability, office attendance, absences, holidays and company calendar events."/>

            </StackPanel>

        </Border>

        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#FAFAFA"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

            <Button Content="Close"
                    Width="100"
                    Height="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,25,0"
                    Click="CloseButton_Click"/>

        </Border>

    </Grid>

</Window>