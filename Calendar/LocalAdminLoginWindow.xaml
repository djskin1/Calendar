<Window x:Class="Calendar.LocalAdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LoginLoc}" 
        Height="650" 
        Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        Icon="/Images/icon.png">

    <Window.Resources>

        <!-- Primary button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#087F8C"/>
            <Setter Property="BorderBrush" Value="#087F8C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small utility button -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#087F8C">

            <Grid Margin="30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="70"
                        Height="70"
                        Background="White"
                        CornerRadius="10"
                        Padding="8"
                        VerticalAlignment="Center">

                    <Image Source="/Images/Logo.png" 
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="{DynamicResource AppName}" 
                               FontSize="23" 
                               FontWeight="SemiBold" 
                               Foreground="White"/>
                    <TextBlock Text="{DynamicResource Locadmin}" 
                               FontSize="13" 
                               Foreground="#D6F3F5"
                               Margin="0,4,0,0"/>

                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Login -->
        <Border Grid.Row="1"
                Margin="30"
                Padding="36,30"
                Background="White"
                CornerRadius="14"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                            Text="{DynamicResource adminsignin}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Grid.Row="1"
                            Text="{DynamicResource loginsub}"
                           TextWrapping="Wrap"
                           Foreground="#6B7280"
                           FontSize="12"
                           Margin="0,5,0,22"/>

                <!-- Username -->
                <TextBlock Grid.Row="2"
                            Text="{DynamicResource Username}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#374151"/>
                <Border Grid.Row="3"
                        Height="52"
                        Margin="0,8,0,18"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#F9FAFB"
                                CornerRadius="10,0,0,10"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Grid Grid.Column="1"
                              Margin="15,0">
                            <TextBox x:Name="UsernameTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="15"
                                     VerticalAlignment="Center"
                                     TextChanged="UsernameTextBox_TextChanged"/>
                            <TextBlock x:Name="UsernamePlaceholderText"
                                       Text="{DynamicResource UserPlace}"
                                       Foreground="#9CA3AF"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                        </Grid>
                    </Grid>
                </Border>

                <!-- Password -->
                <TextBlock Grid.Row="4"
                           Text="{DynamicResource Password}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#374151"/>

                <Border Grid.Row="5"
                        Height="52"
                        Margin="0,8,0,10"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="82"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#F9FAFB"
                                CornerRadius="10,0,0,10"
                                BorderBrush="#E5E7EB"
                                BorderThickness="0,0,1,0">
                            <TextBlock Text="&#xE72E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="#6B7280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Grid Grid.Column="1"
                              Margin="15,0">
                            <PasswordBox x:Name="PasswordTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="15"
                                         VerticalContentAlignment="Center"
                                         KeyDown="PasswordTextBox_KeyDown"/>
                            <TextBox x:Name="VisiblePasswordTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed"
                                     TextChanged="VisiblePasswordTextBox_TextChanged"
                                     KeyDown="VisiblePasswordTextBox_KeyDown"/>

                            <TextBlock x:Name="PasswordPlaceholderText"
                                       Text="{DynamicResource PassPlace}"
                                       Foreground="#9CA3AF"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <Border Grid.Column="2"
                                Background="#F9FAFB"
                                CornerRadius="0,10,10,0"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1,0,0,0">
                            <Button x:Name="ShowPasswordButton"
                                    Content="{DynamicResource Show}"
                                    Width="58"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Click="ShowPasswordButton_Click"/>

                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Grid.Row="6"
                          Text=""
                           Foreground="#B91c1c"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10"
                           Visibility="Collapsed"/>

                <!-- Buttons -->
                <Grid Grid.Row="7"
                     Margin="0,15,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>


                    <Button Grid.Column="1"
                            Content="{DynamicResource Cancel}"
                            Height="40"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>

                    <Button x:Name="SignInButton"
                            Grid.Column="3"
                            Content="{DynamicResource Signin}"
                            Height="40"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SignInButton_Click"/>

                </Grid>
            </Grid>

        </Border>
        

    </Grid>
</Window>
