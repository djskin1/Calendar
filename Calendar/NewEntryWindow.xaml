<Window x:Class="CompanyCalendar.NewEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NewTitle}"
        Icon="/Images/Icon.png"
        Width="480"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

	<Grid Margin="25">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="20"/>
			<RowDefinition Height="*"/>
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">

			<TextBlock Text="{DynamicResource NewTitle}"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold"/>

			<TextBlock Text="{DynamicResource NewSubtitle}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,5,0,0"/>

		</StackPanel>

		<Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8"
                Padding="20">

			<StackPanel>

				<TextBlock Text="{DynamicResource Employee}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontWeight="SemiBold"/>

				<ComboBox x:Name="EmployeeComboBox"
                          Height="36"
                          Margin="0,5,0,18"
                          DisplayMemberPath="DisplayName"/>

				<TextBlock Text="{DynamicResource Date}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontWeight="SemiBold"/>

				<DatePicker x:Name="EntryDatePicker"
                            Height="36"
                            Margin="0,5,0,18"/>

                <TextBlock Text="{DynamicResource Status}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontWeight="SemiBold"/>

				<ComboBox x:Name="StatusComboBox"
                          Height="36"
                          Margin="0,5,0,18">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Code}"
                                           FontWeight="SemiBold"
                                           Width="75"/>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

				</ComboBox>

                <TextBlock Text="{DynamicResource Recurrence}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="RecurrenceComboBox"
                          Height="36"
                          Margin="0,5,0,18"
                          SelectedIndex="0">

					<ComboBoxItem Tag="Once"
                                  Content="{DynamicResource Once}"/>
					<ComboBoxItem Tag="Daily"
                                  Content="{DynamicResource Daily}"/>
					<ComboBoxItem Tag="Weekly"
                                  Content="{DynamicResource Weekly}"/>
					<ComboBoxItem Tag="Every2Weeks"
                                  Content="{DynamicResource Every2Weeks}"/>
					<ComboBoxItem Tag="Every3Weeks"
                                  Content="{DynamicResource Every3Weeks}"/>
					<ComboBoxItem Tag="Every4Weeks"
                                  Content="{DynamicResource Every4Weeks}"/>

				</ComboBox>

                <TextBlock Text="{DynamicResource Notes}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontWeight="SemiBold"/>

				<TextBox x:Name="NotesTextBox"
                         Height="75"
                         Margin="0,5"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>

			</StackPanel>

		</Border>

		<StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

			<Button Content="{DynamicResource Cancel}"
                    Width="90"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

			<Button Content="{DynamicResource Save}"
                    Width="100"
                    Height="38"
                    Click="SaveButton_Click"/>

		</StackPanel>

	</Grid>

</Window>