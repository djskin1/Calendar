    <sys:String x:Key="Create">Rem calendarii creare</sys:String>
    <sys:String x:Key="Helpcreate1">• Preme «Nova res» in instrumentis calendarii.</sys:String>
    <sys:String x:Key="Helpcreate2">• Operarium elige, si alium operarium administrare licet.</sys:String>
    <sys:String x:Key="Helpcreate3">• Diem elige.</sys:String>
    <sys:String x:Key="Helpcreate4">• Statum calendarii desideratum elige.</sys:String>
