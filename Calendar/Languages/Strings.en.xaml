    <sys:String x:Key="Create">
        Create a calandar entry
    </sys:String>

    <sys:String x:Key="Helpcreate1">
        • Click New Entry in the calendar toolbar.
    </sys:String>
    <sys:String x:Key="Helpcreate2">
        • Select the employee if you have permission to manage another employee.
    </sys:String>
    <sys:String x:Key="Helpcreate3">
        • Select the date.
    </sys:String>
    <sys:String x:Key="Helpcreate4">
        • Select the required calendar status.
    </sys:String>
    <sys:String x:Key="Helpcreate5">
        • Select a recurrence option when required.
    </sys:String>
    <sys:String x:Key="Helpcreate6">
        • Enter optional notes.
    </sys:String>
    <sys:String x:Key="Helpcreate7">
        • Click Save.
    </sys:String>

