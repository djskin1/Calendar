    </sys:String>
    <sys:String x:Key="Re6">
        • Every 3 weeks
    </sys:String>
    <sys:String x:Key="Re7">
        • Every 4 weeks
    </sys:String>

    <sys:String x:Key="Groups">
        Groups
    </sys:String>
    <sys:String x:Key="Groups1">
        All contains all active employees.
    </sys:String>
    <sys:String x:Key="Groups2">
        • All does not have its own calendar status.
    </sys:String>
    <sys:String x:Key="Groups3">
        • Groups such as BHV and I&amp;T can be expanded or collapsed.
    </sys:String>
    <sys:String x:Key="Groups4">
        • Employees can appear in multiple groups.
    </sys:String>
    <sys:String x:Key="Groups5">
        • The same employee always uses the same calendar information in every group.
    </sys:String>
    <sys:String x:Key="Groups6">
        • When Microsoft Entra ID is connected, group membership is synchronized from Entra ID.
    </sys:String>

    <sys:String x:Key="Weekhol">
        Weekends and holidays
    </sys:String>
    <sys:String x:Key="Weekhol1">
        • Saturdays and Sundays are shown in grey.
    </sys:String>
    <sys:String x:Key="Weekhol2">
        • Weekend days cannot normally be edited.
    </sys:String>
    <sys:String x:Key="Weekhol3">
        • Dutch public holidays can be displayed automatically.
    </sys:String>
    <sys:String x:Key="Weekhol4">
        • Mandatory company-wide days off are controlled by authorized users.
    </sys:String>

    <sys:String x:Key="Nav">
        Navigation
    </sys:String>
    <sys:String x:Key="Nav1">
        Use Previous and Next to move through the calendar.
    </sys:String>
    <sys:String x:Key="Nav2">
        • Click to return to the current period.
    </sys:String>
    <sys:String x:Key="Nav3">
        • Click Refresh to reload the latest calendar information.
    </sys:String>
    <sys:String x:Key="Nav4">
        • Click a group header to expand or collapse that group.
    </sys:String>

    <sys:String x:Key="Search1">
        Use Search to find an employee or quickly locate calendar information.
    </sys:String>

    <sys:String x:Key="MsEID">
        Microsoft Entra ID
    </sys:String>
    <sys:String x:Key="MsEID1">
        When Microsoft Entra ID is configured by an administrator:
    </sys:String>
    <sys:String x:Key="MsEID2">
        • Users can sign in with their Microsoft account.
    </sys:String>
    <sys:String x:Key="MsEID3">
        • Employees and group memberships can be synchronized automatically.
    </sys:String>
    <sys:String x:Key="MsEID4">
        • The user's Microsoft profile name and profile picture can be displayed.
    </sys:String>
    <sys:String x:Key="MsEID5">
        • Only groups enabled by an administrator are displayed in the calendar.
    </sys:String>

    <sys:String x:Key="Hint">
        Tips &amp; Tricks
    </sys:String>
    <sys:String x:Key="Hint1">
        • Collapse groups you do not need to keep the calendar easier to read.
    </sys:String>
    <sys:String x:Key="Hint2">
        • Use Today to quickly return to the current week.
    </sys:String>
    <sys:String x:Key="Hint3">
        • Use Refresh after synchronization or when calendar information has changed.
    </sys:String>
    <sys:String x:Key="Hint4">
        • The same employee may be shown under All and multiple groups without creating duplicate calendar entries.
    </sys:String>
    
