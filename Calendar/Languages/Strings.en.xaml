    </sys:String>

    <sys:String x:Key="Re1">
        Available recurrence options can include:
    </sys:String>
    <sys:String x:Key="Re2">
        • Once
    </sys:String>
    <sys:String x:Key="Re3">
        • Daily
    </sys:String>
    <sys:String x:Key="Re4">
        • Every week
    </sys:String>
    <sys:String x:Key="Re5">
