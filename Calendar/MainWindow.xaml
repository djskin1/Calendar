<Window x:Class="CompanyCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Central calendar 2.0"
        Width="1500"
        Height="850"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

	<!--
        We deliberately keep the standard Windows title bar.
        This gives us native Minimize, Maximize/Restore and Close buttons.
    -->

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="210"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ========================= -->
		<!-- LEFT SIDEBAR -->
		<!-- ========================= -->

		<Border Grid.Column="0"
                Background="#087F8C">

			<Grid Margin="14">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="25"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="20"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Application name -->

				<StackPanel>

					<TextBlock Text="Central"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="SemiBold"/>

					<TextBlock Text="calendar"
                               Foreground="#DFF6F7"
                               FontSize="17"/>

				</StackPanel>

				<!-- Calendar -->

				<Button Grid.Row="2"
                        Height="45"
                        Margin="0,4"
                        HorizontalContentAlignment="Left"
                        Click="CalendarButton_Click">

					<StackPanel Orientation="Horizontal">

						<!-- Calendar icon -->
						<TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="8,0,12,0"/>

						<TextBlock Text="Calendar"
                                   VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- Admin -->

				<Button Grid.Row="3"
                        Height="45"
                        Margin="0,4"
                        HorizontalContentAlignment="Left"
                        Click="AdminButton_Click">

					<StackPanel Orientation="Horizontal">

						<!-- Settings icon -->
						<TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="8,0,12,0"/>

						<TextBlock Text="Admin"
                                   VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- Search -->

				<Button Grid.Row="5"
                        Height="42"
                        Margin="0,4"
                        HorizontalContentAlignment="Left"
                        Click="SearchButton_Click">

					<StackPanel Orientation="Horizontal">

						<TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Margin="8,0,12,0"/>

						<TextBlock Text="Search"/>

					</StackPanel>

				</Button>

				<!-- Help -->

				<Button Grid.Row="6"
                        Height="42"
                        Margin="0,4"
                        HorizontalContentAlignment="Left"
                        Click="HelpButton_Click">

					<StackPanel Orientation="Horizontal">

						<TextBlock Text="&#xE897;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Margin="8,0,12,0"/>

						<TextBlock Text="Help"/>

					</StackPanel>

				</Button>

				<!-- Logo placeholder -->

				<Border Grid.Row="8"
                        Height="90"
                        Margin="5,10"
						Padding="8"
                        CornerRadius="6"
                        Background="#FFFFFF">

					<svgc:SvgViewbox Source="/Images/cardialysis-logo.svg"
									 Stretch="Uniform"
									 HorizontalAlignment="Stretch"
									 VerticalAlignment="Stretch"/> 

				</Border>

				<!-- Version -->

				<Button Grid.Row="9"
                        Content="Version 2.0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="VersionButton_Click"/>

			</Grid>

		</Border>

		<!-- ========================= -->
		<!-- MAIN AREA -->
		<!-- ========================= -->

		<Grid Grid.Column="1">

			<Grid.RowDefinitions>
				<RowDefinition Height="65"/>
				<RowDefinition Height="72"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- ========================= -->
			<!-- TOP USER BAR -->
			<!-- ========================= -->

			<Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

				<Grid Margin="20,0">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBlock Text="Central calendar"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#111827"/>

					<!-- Logged in user -->

					<StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

						<!-- Profile image placeholder -->

						<Border Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#E5E7EB"
                                Margin="0,0,10,0">

							<TextBlock x:Name="UserProfileIcon"
                                       Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#4B5563"/>

						</Border>

						<StackPanel VerticalAlignment="Center">

							<TextBlock x:Name="LoggedInUserText"
                                       Text="Local user"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

							<TextBlock x:Name="LoginTypeText"
                                       Text="Local calendar"
                                       FontSize="11"
                                       Foreground="#6B7280"/>

						</StackPanel>

					</StackPanel>

				</Grid>

			</Border>

			<!-- ========================= -->
			<!-- CALENDAR TOOLBAR -->
			<!-- ========================= -->

			<Border Grid.Row="1"
                    Background="#FAFAFA"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

				<Grid Margin="20,12">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- Previous -->

					<Button Grid.Column="0"
                            Width="42"
                            Height="38"
                            ToolTip="Previous period"
                            Click="PreviousButton_Click">

						<TextBlock Text="&#xE76B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>

					</Button>

					<!-- Today -->

					<Button Grid.Column="1"
                            Content="Today"
                            Width="75"
                            Height="38"
                            Margin="7,0"
                            Click="TodayButton_Click"/>

					<!-- Next -->

					<Button Grid.Column="2"
                            Width="42"
                            Height="38"
                            ToolTip="Next period"
                            Click="NextButton_Click">

						<TextBlock Text="&#xE76C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>

					</Button>

					<!-- Period -->

					<TextBlock x:Name="PeriodText"
                               Grid.Column="3"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

					<!-- Refresh -->

					<Button Grid.Column="4"
                            Width="42"
                            Height="38"
                            Margin="0,0,10,0"
                            ToolTip="Refresh calendar"
                            Click="RefreshButton_Click">

						<TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"/>

					</Button>

					<!-- New Entry -->

					<Button Grid.Column="5"
                            Height="38"
                            Padding="16,0"
                            Click="NewEntryButton_Click">

						<StackPanel Orientation="Horizontal">

							<TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Margin="0,0,8,0"/>

							<TextBlock Text="New Entry"/>

						</StackPanel>

					</Button>

				</Grid>

			</Border>

			<!-- ========================= -->
			<!-- EMPLOYEE CALENDAR -->
			<!-- ========================= -->

			<Border Grid.Row="2"
                    Margin="18"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="7">

				<DataGrid x:Name="CalendarGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          BorderThickness="0"
                          SelectionUnit="Cell"
                          SelectionMode="Single"
                          FrozenColumnCount="1"
                          RowHeight="31"
                          ColumnHeaderHeight="58"
                          FontSize="12"
                          IsReadOnly="True">

					<DataGrid.Resources>

						<!-- Department / function group -->

						<Style TargetType="{x:Type GroupItem}">

							<Setter Property="Template">

								<Setter.Value>

									<ControlTemplate TargetType="{x:Type GroupItem}">

										<StackPanel>

											<Border Background="#EEF2F3"
                                                    BorderBrush="#D1D5DB"
                                                    BorderThickness="0,1,0,1"
                                                    Padding="8,5">

												<TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="#111827"/>

											</Border>

											<ItemsPresenter/>

										</StackPanel>

									</ControlTemplate>

								</Setter.Value>

							</Setter>

						</Style>

					</DataGrid.Resources>

					<!-- Employee is the only static column.
                         Date columns are generated from C#. -->

					<DataGrid.Columns>

						<DataGridTextColumn Header="Employee"
                                            Binding="{Binding DisplayName}"
                                            Width="190"
                                            MinWidth="160"/>

					</DataGrid.Columns>

				</DataGrid>

			</Border>

		</Grid>

	</Grid>

</Window>