<Window x:Class="CompanyCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="{DynamicResource AppName}"
		Icon="/Images/icon.png"
        Width="1200"
        Height="600"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

	<!--
        We deliberately keep the standard Windows title bar.
        This gives us native Minimize, Maximize/Restore and Close buttons.
    -->

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="210"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ========================= -->
		<!-- LEFT SIDEBAR -->
		<!-- ========================= -->

		<Border Grid.Column="0"
                Background="#087F8C">

			<Grid Margin="14">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="25"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- Application name -->

				<StackPanel>

                    <TextBlock Text="{DynamicResource AppName}"
                               Foreground="White"
                               FontSize="23"
                               FontWeight="SemiBold"/>

                </StackPanel>

				<!-- Calendar -->

				<Button Grid.Row="2"
                        Height="45"
                        Margin="0,4"
                        HorizontalContentAlignment="Left"
                        Click="CalendarButton_Click">

					<StackPanel Orientation="Horizontal">

						<!-- Calendar icon -->
						<TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="8,0,12,0"/>

                        <TextBlock Text="{DynamicResource NavCalendar}"
                                   VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- Admin -->

				<Button x:Name="AdminButton"
                        Grid.Row="3"
                        Height="45"
                        Margin="0,4"
                        HorizontalContentAlignment="Left"
                        Visibility="Visible"
                        Click="AdminButton_Click">

					<StackPanel Orientation="Horizontal">

						<!-- Settings icon -->
						<TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="8,0,12,0"/>

                        <TextBlock Text="{DynamicResource NavAdmin}"
                                   VerticalAlignment="Center"/>

					</StackPanel>

				</Button>
				
				<!-- Settings -->
				<Button Grid.Row="4"
						Height="45"
						Margin="0,4"
						HorizontalContentAlignment="Left"
						Click="SettingsButton_Click">
					<StackPanel Orientation="horizontal">
						<TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="8,0,12,0"/>

                        <TextBlock Text="{DynamicResource NavSettings}"
                                   VerticalAlignment="Center"/>
					</StackPanel>
				</Button>

				<!-- Search -->

				<Button Grid.Row="5"
                        Height="42"
                        Margin="0,4"
                        HorizontalContentAlignment="Left"
                        Click="SearchButton_Click">

					<StackPanel Orientation="Horizontal">

						<TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Margin="8,0,12,0"/>

                        <TextBlock Text="{DynamicResource NavSearch}"/>

					</StackPanel>

				</Button>

				<!-- Help -->

				<Button Grid.Row="6"
                        Height="42"
                        Margin="0,4"
                        HorizontalContentAlignment="Left"
                        Click="HelpButton_Click">

					<StackPanel Orientation="Horizontal">

						<TextBlock Text="&#xE897;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Margin="8,0,12,0"/>

                        <TextBlock Text="{DynamicResource NavHelp}"/>

					</StackPanel>

				</Button>

				<!-- Logo placeholder -->

				<Border Grid.Row="8"
                        Height="90"
                        Margin="5,10"
						Padding="8"
                        CornerRadius="6"
                        Background="#FFFFFF">

                    <Image x:Name="CompanyLogoImage"
                           Source="/Images/Logo.png"
                           Stretch="Uniform"/>

                </Border>

				<!-- Version -->

                <Button x:Name="VersionButton"
                        Grid.Row="9"
                        Content="{DynamicResource Version}"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="VersionButton_Click"/>

			</Grid>

		</Border>

		<!-- ========================= -->
		<!-- MAIN AREA -->
		<!-- ========================= -->

		<Grid 
            x:Name="CalendarPage"
            Grid.Column="1">

			<Grid.RowDefinitions>
				<RowDefinition Height="65"/>
				<RowDefinition Height="72"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- ========================= -->
			<!-- TOP USER BAR -->
			<!-- ========================= -->

			<Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

				<Grid Margin="20,0">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource AppName}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#111827"/>

					<!-- Logged in user -->

                    <Border Grid.Column="1"
                            Background="Transparent"
                            Cursor="Hand"
                            Padding="6"
                            MouseLeftButtonUp="AccountArea_MouseLeftButtonUp">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#E5E7EB"
                                    Margin="0,0,10,0"
                                    ClipToBounds="True">

                                <Grid>
                                    <Image x:Name="UserProfileImage"
                                           Stretch="UniformToFill"
                                           Visibility="Collapsed"/>

                                    <TextBlock x:Name="UserProfileIcon"
                                               Text="&#xE77B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="#4B5563"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Grid>
                            </Border>

                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,8,0">

                                <TextBlock x:Name="LoggedInUserText"
                                           Text="{DynamicResource NotSignedIn}"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"/>
                                <TextBlock x:Name="LoginTypeText"
                                           Text="{DynamicResource Localcalendar}"
                                           FontSize="11"
                                           Foreground="#6B7280"/>

                            </StackPanel>
                            
                            <TextBlock Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                        
                    </Border>

				</Grid>

			</Border>

			<!-- ========================= -->
			<!-- CALENDAR TOOLBAR -->
			<!-- ========================= -->

			<Border Grid.Row="1"
                    Background="#FAFAFA"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

				<Grid Margin="20,12">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- Previous -->

					<Button Grid.Column="0"
                            Width="42"
                            Height="38"
                            ToolTip="Previous period"
                            Click="PreviousButton_Click">

						<TextBlock Text="&#xE76B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>

					</Button>

					<!-- Today -->

					<Button Grid.Column="1"
                            Content="{DynamicResource Today}"
                            Width="75"
                            Height="38"
                            Margin="7,0"
                            Click="TodayButton_Click"/>
                    
                    <!-- Date Picker -->

                    <DatePicker x:Name="GoToDatePicker"
                                Grid.Column="2"
                                Width="145"
                                Height="38"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                ToolTip="Go to date"
                                SelectedDateChanged="GoToDatePicker_SelectedDateChanged"/>

                    <!-- Next -->

					<Button Grid.Column="3"
                            Width="42"
                            Height="38"
                            ToolTip="Next period"
                            Click="NextButton_Click">

						<TextBlock Text="&#xE76C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"/>

					</Button>

					<!-- Period -->

					<TextBlock x:Name="PeriodText"
                               Grid.Column="4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>

					<!-- Refresh -->

					<Button Grid.Column="5"
                            Width="42"
                            Height="38"
                            Margin="0,0,10,0"
                            ToolTip="Refresh calendar"
                            Click="RefreshButton_Click">

						<TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"/>

					</Button>

					<!-- New Entry -->

					<Button Grid.Column="6"
                            Height="38"
                            Padding="16,0"
                            Click="NewEntryButton_Click">

						<StackPanel Orientation="Horizontal">

							<TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="{DynamicResource NewEntry}"/>

						</StackPanel>

					</Button>

				</Grid>

			</Border>

			<!-- ========================= -->
			<!-- EMPLOYEE CALENDAR -->
			<!-- ========================= -->

			<Border Grid.Row="2"
                    Margin="18"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="7">

				<DataGrid x:Name="CalendarGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          BorderThickness="0"
                          SelectionUnit="Cell"
                          SelectionMode="Single"
                          FrozenColumnCount="1"
                          RowHeight="31"
                          ColumnHeaderHeight="58"
                          FontSize="12"
                          IsReadOnly="True">

					<DataGrid.Resources>

						<!-- Department / function group -->

						<Style TargetType="{x:Type GroupItem}">

							<Setter Property="Template">

								<Setter.Value>

									<ControlTemplate TargetType="{x:Type GroupItem}">

										<StackPanel>

											<Border Background="#EEF2F3"
                                                    BorderBrush="#D1D5DB"
                                                    BorderThickness="0,1,0,1"
                                                    Padding="8,5">

												<TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="#111827"/>

											</Border>

											<ItemsPresenter/>

										</StackPanel>

									</ControlTemplate>

								</Setter.Value>

							</Setter>

						</Style>

					</DataGrid.Resources>

					<!-- Employee is the only static column.
                         Date columns are generated from C#. -->

					<DataGrid.Columns>

                        <DataGridTextColumn Header="{DynamicResource Employee}"
                                            Binding="{Binding DisplayName}"
                                            Width="190"
                                            MinWidth="160"/>

					</DataGrid.Columns>

				</DataGrid>

			</Border>

		</Grid>

        <Grid x:Name="HelpPage"
      Grid.Column="1"
      Visibility="Collapsed"
      Background="#F3F4F6">

            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <Border Grid.Row="0"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,0,1">

                <Grid Margin="25,0">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="{DynamicResource Help}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                        <TextBlock Text="{DynamicResource subtitleHelp}"
                           FontSize="13"
                           Foreground="#6B7280"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Scrollable help -->

            <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="30"
                    MaxWidth="900"
                    HorizontalAlignment="Left">

                    <!-- ================================================= -->
                    <!-- OVERVIEW -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource AppName}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

                    <TextBlock Margin="0,5,0,25"
                       TextWrapping="Wrap"
                       Foreground="#6B7280"
                       Text="{DynamicResource subtitleHelp2}"/>

                    <!-- ================================================= -->
                    <!-- LEGEND -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource CalendarLegend}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

                    <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,30">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->

                            <Border Grid.Row="0"
                            Grid.ColumnSpan="3"
                            Background="#EEF2F3"/>

                            <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{DynamicResource Color}"
                               FontWeight="SemiBold"
                               Margin="10"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{DynamicResource Code}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{DynamicResource Description}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                            <!-- OFFI -->

                            <Border Grid.Row="1"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"/>

                            <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{DynamicResource OFFI}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="{DynamicResource WorkOffice}"
                               VerticalAlignment="Center"/>

                            <!-- HOME -->

                            <Border Grid.Row="2"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#A6FF8A"/>

                            <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Text="{DynamicResource Home}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="{DynamicResource WorkHome}"
                               VerticalAlignment="Center"/>

                            <!-- HO/AB -->

                            <Border Grid.Row="3"
                            Grid.Column="0"
                            Margin="8,4">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">

                                        <GradientStop Color="#A6FF8A"
                                              Offset="0"/>

                                        <GradientStop Color="#A6FF8A"
                                              Offset="0.5"/>

                                        <GradientStop Color="#C00000"
                                              Offset="0.5"/>

                                        <GradientStop Color="#C00000"
                                              Offset="1"/>

                                    </LinearGradientBrush>
                                </Border.Background>

                            </Border>

                            <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="{DynamicResource HO/AB}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3"
                               Grid.Column="2"
                               Text="{DynamicResource HomeAbs}"
                               VerticalAlignment="Center"/>

                            <!-- OF/AB -->

                            <Border Grid.Row="4"
                            Grid.Column="0"
                            Margin="8,4">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">

                                        <GradientStop Color="White"
                                              Offset="0"/>

                                        <GradientStop Color="White"
                                              Offset="0.5"/>

                                        <GradientStop Color="#C00000"
                                              Offset="0.5"/>

                                        <GradientStop Color="#C00000"
                                              Offset="1"/>

                                    </LinearGradientBrush>
                                </Border.Background>

                            </Border>

                            <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Text="{DynamicResource OF/AB}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4"
                               Grid.Column="2"
                               Text="{DynamicResource OfficeAbs}"
                               VerticalAlignment="Center"/>

                            <!-- HO/OF -->

                            <Border Grid.Row="5"
                            Grid.Column="0"
                            Margin="8,4">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">

                                        <GradientStop Color="#A6FF8A"
                                              Offset="0"/>

                                        <GradientStop Color="#A6FF8A"
                                              Offset="0.5"/>

                                        <GradientStop Color="White"
                                              Offset="0.5"/>

                                        <GradientStop Color="White"
                                              Offset="1"/>

                                    </LinearGradientBrush>
                                </Border.Background>

                            </Border>

                            <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               Text="{DynamicResource HO/OF}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5"
                               Grid.Column="2"
                               Text="{DynamicResource HomeOffice}"
                               VerticalAlignment="Center"/>

                            <!-- CONG -->

                            <Border Grid.Row="6"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#FF9940"/>

                            <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Text="{DynamicResource CONG}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="6"
                               Grid.Column="2"
                               Text="{DynamicResource Congress}"
                               VerticalAlignment="Center"/>

                            <!-- MEET -->

                            <Border Grid.Row="7"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#FF9940"/>

                            <TextBlock Grid.Row="7"
                               Grid.Column="1"
                               Text="{DynamicResource MEET}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7"
                               Grid.Column="2"
                               Text="{DynamicResource Externalmeet}"
                               VerticalAlignment="Center"/>

                            <!-- MV -->

                            <Border Grid.Row="8"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#FF9940"/>

                            <TextBlock Grid.Row="8"
                               Grid.Column="1"
                               Text="{DynamicResource MF}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="8"
                               Grid.Column="2"
                               Text="{DynamicResource Monvis}"
                               VerticalAlignment="Center"/>

                            <!-- OPT -->

                            <Border Grid.Row="9"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#FF0000"/>

                            <TextBlock Grid.Row="9"
                               Grid.Column="1"
                               Text="{DynamicResource OPT}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="9"
                               Grid.Column="2"
                               Text="{DynamicResource Option}"
                               VerticalAlignment="Center"/>

                            <!-- ABS -->

                            <Border Grid.Row="10"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#C00000"/>

                            <TextBlock Grid.Row="10"
                               Grid.Column="1"
                               Text="{DynamicResource ABS}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="10"
                               Grid.Column="2"
                               Text="{DynamicResource Absence}"
                               VerticalAlignment="Center"/>

                            <!-- Weekend -->

                            <Border Grid.Row="11"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#808080"/>

                            <TextBlock Grid.Row="11"
                               Grid.Column="2"
                               Text="{DynamicResource Weekend}"
                               VerticalAlignment="Center"/>

                            <!-- PUB -->

                            <Border Grid.Row="12"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#E00000"/>

                            <TextBlock Grid.Row="12"
                               Grid.Column="1"
                               Text="{DynamicResource PUB}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="12"
                               Grid.Column="2"
                               Text="{DynamicResource Public holiday}"
                               VerticalAlignment="Center"/>

                            <!-- MF -->

                            <Border Grid.Row="13"
                            Grid.Column="0"
                            Margin="8,4"
                            Background="#D00000"/>

                            <TextBlock Grid.Row="13"
                               Grid.Column="1"
                               Text="{DynamicResource MF}"
                               VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="13"
                               Grid.Column="2"
                               Text="{DynamicResource Mandatory}"
                               VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- ================================================= -->
                    <!-- CREATE ENTRY -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource Create}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <StackPanel Margin="10,0,0,25">
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource Helpcreate1}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Helpcreate2}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Helpcreate3}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Helpcreate4}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Helpcreate5}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Helpcreate6}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Helpcreate7}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- RECURRENCE -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource Recurringentries}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <StackPanel Margin="10,0,0,25">
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource Re1}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Re2}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Re3}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Re4}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Re5}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Re6}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Re7}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- GROUPS -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource Groups}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <StackPanel Margin="10,0,0,25">
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource Groups1}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Groups2}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Groups3}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Groups4}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Groups5}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Groups6}"/>
                        </TextBlock>

                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- WEEKENDS / HOLIDAYS -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource Weekhol}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <StackPanel Margin="10,0,0,25">
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource Weekhol1}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource Weekhol2}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Weekhol3}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Weekhol4}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- NAVIGATION -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource Nav}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <StackPanel Margin="10,0,0,25">
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Nav1}"/> 
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Nav2}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Nav3}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                    Margin="0,0,0,6">
                            <Run Text="{DynamicResource Nav4}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- SEARCH -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource Search}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <TextBlock TextWrapping="Wrap"
                       LineHeight="22"
                       Margin="10,0,0,25"
                       Text="{DynamicResource Search1}"/>

                    <!-- ================================================= -->
                    <!-- ENTRA -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource MsEID}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <StackPanel Margin="10,0,0,25">
                        <TextBlock TextWrapping="Wrap"                                    
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource MsEID1}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"                                    
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource MsEID2}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"                                    
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource MsEID3}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"                                    
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource MsEID4}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"                                    
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource MsEID5}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- TIPS -->
                    <!-- ================================================= -->

                    <TextBlock Text="{DynamicResource Hint}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <StackPanel Margin="10,0,0,40">
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            "<Run Text="{DynamicResource Hint1}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource Hint2}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource Hint3}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,6">
                            <Run Text="{DynamicResource Hint4}"/>
                        </TextBlock>
                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Grid>

        <Grid x:Name="SearchPage"
              Grid.Column="1"
              Visibility="Collapsed"
              Background="#F3F4F6">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="25,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Search}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                        <TextBlock Text="{DynamicResource SutitleSearch}"
                           FontSize="12"
                           Foreground="#6B7280"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Height="42"
                            Background="#F9FAFB"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="10"
                            VerticalAlignment="Center">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                            <Grid Grid.Column="1"
                                   Margin="5,0,12,0">

                                <TextBox x:Name="SearchTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"/>

                                <TextBlock x:Name="SearchPlaceholder"
                                   Text="{DynamicResource Searchplace}"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                            </Grid>
                        </Grid>

                    </Border>
                    
                </Grid>
                
            </Border>

            <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="25"
                    MaxWidth="1000"
                    HorizontalAlignment="Left">

                    <!-- No results -->

                    <Border x:Name="NoSearchResultsPanel"
                    Width="650"
                    Padding="30"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">

                        <StackPanel HorizontalAlignment="Center">

                            <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="30"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"/>

                            <TextBlock Text="{DynamicResource notfound}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               Foreground="#374151"
                               HorizontalAlignment="Center"/>

                            <TextBlock Text="{DynamicResource notfound2}"
                               Foreground="#6B7280"
                               Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                    <ItemsControl x:Name="SearchResultsList">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Width="750"
                                Margin="0,0,0,12"
                                Padding="18"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42"
                                        Height="42"
                                        CornerRadius="21"
                                        Background="#EEF6F7"
                                        VerticalAlignment="Top">

                                            <TextBlock Text="{Binding Icon}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="#087F8C"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock Text="{Binding Title}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"/>

                                            <TextBlock Text="{Binding Type}"
                                               FontSize="11"
                                               Foreground="#087F8C"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,5"/>

                                            <TextBlock Text="{Binding Description}"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"/>
                                            
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                           Text="{Binding DateText}"
                                           Foreground="#374151"
                                           FontWeight="SemiBold"
                                           Margin="20,0,0,0"
                                           VerticalAlignment="Top"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
                        
                        

            </ScrollViewer>

        </Grid>

		<Grid x:Name="SettingsPage"
			  Grid.Column="1"
			  Visibility="Collapsed"
			  Background="#F3F4F6">

			<Grid.RowDefinitions>
				<RowDefinition Height="76"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Border Grid.Row="0"
					Background="White"
					BorderBrush="#E5E7EB"
					BorderThickness="0,0,0,1">

				<StackPanel Margin="20,0"
							VerticalAlignment="Center">
					<TextBlock Text="{DynamicResource SettingsTitle}"
							   FontSize="24"
							   FontWeight="SemiBold"
							   Foreground="#111827"/>
					<TextBlock Text="{DynamicResource SettingsSubtitle}"
							   Margin="0,3,0,0"
							   FontSize="12"
							   Foreground="#6B7280"/>
				</StackPanel>
				
			</Border>

			<ScrollViewer Grid.Row="1"
						  v>
				
			</ScrollViewer>
			
		</Grid>

    </Grid>

</Window>