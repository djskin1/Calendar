<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush"
                     Color="#F3F4F6"/>

    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SecondarySurfaceBrush"
                     Color="#FAFAFA"/>

    <SolidColorBrush x:Key="BorderBrush"
                     Color="#E5E7EB"/>

    <SolidColorBrush x:Key="PrimaryTextBrush"
                     Color="#111827"/>

    <SolidColorBrush x:Key="SecondaryTextBrush"
                     Color="#6B7280"/>

    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#9CA3AF"/>

    <SolidColorBrush x:Key="InputBackgroundBrush"
                     Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="TransparentBrush"
                     Color="Transparent"/>
    
    <SolidColorBrush x:Key="SidebarBrush"
                     Color="#FF6FE610"/>

    <SolidColorBrush x:Key="ErrorTextBrush"
              Color="#FFFD0505"/>

</ResourceDictionary>