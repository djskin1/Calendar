<Window x:Class="CompanyCalendar.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ColorPickerTitle}"
        Width="520"
        Height="650"
        MinWidth="520"
        MinHeight="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Header -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="{DynamicResource ColorPickerTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Text="{DynamicResource ColorPickerDescription}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

        </StackPanel>


        <!-- ==================================== -->
        <!-- COLOR FIELD + HUE                    -->
        <!-- ==================================== -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>


            <!-- Saturation / brightness area -->

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    ClipToBounds="True">

                <Grid x:Name="ColorField"
                      Cursor="Cross"
                      MouseLeftButtonDown="ColorField_MouseLeftButtonDown"
                      MouseMove="ColorField_MouseMove">

                    <!-- Current hue -->

                    <Rectangle x:Name="HueBackground"
                               Fill="Red"/>

                    <!-- White -> transparent -->

                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">
                                <GradientStop Color="White"
                                              Offset="0"/>
                                <GradientStop Color="#00FFFFFF"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Transparent -> black -->

                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#00000000"
                                              Offset="0"/>
                                <GradientStop Color="Black"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>


                    <!-- Selection marker -->

                    <Ellipse x:Name="ColorMarker"
                             Width="16"
                             Height="16"
                             Stroke="White"
                             StrokeThickness="2"
                             Fill="Transparent"
                             IsHitTestVisible="False">

                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3"
                                              ShadowDepth="0"
                                              Opacity="0.8"/>
                        </Ellipse.Effect>

                    </Ellipse>

                </Grid>

            </Border>


            <!-- Hue bar -->

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">

                <Grid x:Name="HueField"
                      Cursor="Hand"
                      MouseLeftButtonDown="HueField_MouseLeftButtonDown"
                      MouseMove="HueField_MouseMove">

                    <Rectangle>

                        <Rectangle.Fill>

                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">

                                <GradientStop Color="#FFFF0000"
                                              Offset="0"/>

                                <GradientStop Color="#FFFFFF00"
                                              Offset="0.1667"/>

                                <GradientStop Color="#FF00FF00"
                                              Offset="0.3333"/>

                                <GradientStop Color="#FF00FFFF"
                                              Offset="0.5"/>

                                <GradientStop Color="#FF0000FF"
                                              Offset="0.6667"/>

                                <GradientStop Color="#FFFF00FF"
                                              Offset="0.8333"/>

                                <GradientStop Color="#FFFF0000"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Rectangle.Fill>

                    </Rectangle>


                    <Border x:Name="HueMarker"
                            Height="4"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"/>

                </Grid>

            </Border>

        </Grid>


        <!-- ==================================== -->
        <!-- PREVIEW + HEX                       -->
        <!-- ==================================== -->

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Border x:Name="SelectedColorPreview"
                    Grid.Column="0"
                    Height="55"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"/>


            <StackPanel Grid.Column="2">

                <TextBlock Text="{DynamicResource ColorPickerHex}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBox x:Name="HexTextBox"
                         Height="36"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         TextChanged="HexTextBox_TextChanged"/>

            </StackPanel>

        </Grid>


        <!-- ==================================== -->
        <!-- RGB                                 -->
        <!-- ==================================== -->

        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0">

                <TextBlock Text="R"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock x:Name="RedValueText"
                           FontSize="18"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

            </StackPanel>


            <StackPanel Grid.Column="2">

                <TextBlock Text="G"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock x:Name="GreenValueText"
                           FontSize="18"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

            </StackPanel>


            <StackPanel Grid.Column="4">

                <TextBlock Text="B"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock x:Name="BlueValueText"
                           FontSize="18"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

            </StackPanel>

        </Grid>


        <!-- Buttons -->

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="{DynamicResource Cancel}"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="{DynamicResource OK}"
                    Width="100"
                    Height="38"
                    Background="{DynamicResource SidebarBrush}"
                    Foreground="White"
                    Click="OkButton_Click"/>

        </StackPanel>

    </Grid>

</Window>